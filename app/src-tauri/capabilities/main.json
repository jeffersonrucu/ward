{
  "identifier": "main",
  "description": "Janela principal do Ward: só os comandos próprios do app (S11). Nenhuma permissão de plugin nem do núcleo do Tauri, nenhuma origem remota.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-vault-status",
    "allow-copy-field",
    "allow-list-credentials",
    "allow-credential-detail",
    "allow-generate-password",
    "allow-copy-generated-password",
    "allow-reveal-generated-password",
    "allow-discard-generated-password",
    "allow-reveal-field",
    "allow-totp-code",
    "allow-copy-totp-code",
    "allow-use-generated-password",
    "allow-discard-form",
    "allow-save-credential",
    "allow-set-level",
    "allow-choose-attachment",
    "allow-remove-attachment",
    "allow-load-key",
    "allow-connect",
    "allow-create-vault",
    "allow-unlock",
    "allow-listen-notices",
    "allow-settings",
    "allow-change-pin",
    "allow-change-master-password",
    "allow-set-lock-timeout",
    "allow-external-backup",
    "allow-list-usb-drives",
    "allow-set-external-backup",
    "allow-list-backups",
    "allow-restore-backup",
    "allow-lock"
