{
  "productName": "Ward",
  "version": "0.1.5",
  "identifier": "local.ward.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'",
        "object-src": "'none'",
        "media-src": "'none'",
        "manifest-src": "'none'"
      },
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": false
      },
      "capabilities": ["principal", "aprovacao"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  },
  "plugins": {}
}
