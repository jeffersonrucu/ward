#!/bin/bash -p
# postrm of Ward's `.deb` (Phase 52; D47, D60; V9.9, V9.10). After dpkg deletes the
# files: removes the overrides of the setgid binaries, /run/ward (if empty), the systemd
# units and the `ward-app`/`ward-nm` groups the preinst created (mark in
# /usr/local/lib/ward/created-groups, Phase 51a, or, without it, the one a 0.1.x left,
# m2:DT15; like `make uninstall`; both marks go). A group that
# already existed before Ward stays. Never touches the home: the vault and the backups in
# ~/.local/share/ward/ stay.
#
# On an aborted install (preinst refused) the overrides and the groups of the mark go
# (the ones that preinst created): a group that already existed and was refused (D60)
# belongs to the administrator, not to Ward.

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
set -euo pipefail

error() { printf "ward (postrm): %s\n" "$*" >&2; exit 1; }
warning() { printf 'ward: aviso: %s\n' "$*" >&2; }
step() { printf "ward: %s\n" "$*"; }

#@GROUPS@

# The start of the sockets after an aborted upgrade (m2:DT16), from upgrade.sh.
#@UPGRADE@

# Ward's marks and dir (/usr/local/lib/ward): dpkg does not delete a dir with a file that
# is not the package's (a mark), so it goes here.
remove_groups() {
    delete_marked_groups
    rmdir /usr/local/lib/ward 2>/dev/null || true
}

remove_overrides() {
    local c
    for c in /usr/local/bin/ward-app /usr/local/lib/ward/ward-nm; do
        if [ -n "$(dpkg-statoverride --list "$c" || true)" ]; then
            dpkg-statoverride --quiet --remove "$c" || true
        fi
    done
}

case "${1:-}" in
    remove | purge)
        remove_overrides
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl reset-failed 'wardd@*' 2>/dev/null || true
        fi
        if [ -d /run/ward ] && [ ! -L /run/ward ]; then
            for p in /run/ward/*; do
                [ -d "$p" ] && [ ! -L "$p" ] && { rmdir -- "$p" 2>/dev/null || printf 'ward: aviso: %s não está vazia; ficou\n' "$p" >&2; }
            done
            rmdir /run/ward 2>/dev/null || printf 'ward: aviso: /run/ward não está vazia; ficou\n' >&2
        fi
        remove_groups
        printf 'ward: o cofre e os backups em ~/.local/share/ward/ não foram tocados\n'
        ;;
    abort-install)
        remove_overrides
        remove_groups
        ;;
    abort-upgrade)
        # This version's preinst stopped the sockets (m2:DT16) and the upgrade failed: they
        # come back with the binaries dpkg put back.
        if [ -d /run/systemd/system ]; then
            start_enabled_sockets
        fi
        ;;
    upgrade | failed-upgrade | disappear) ;;
    *) printf 'ward (postrm): argumento desconhecido: %s\n' "${1:-}" >&2; exit 1 ;;
esac
exit 0
