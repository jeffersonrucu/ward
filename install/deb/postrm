#!/bin/bash -p
# postrm do `.deb` do Ward (Fase 52; D47, D60; V9.9, V9.10). Depois de o dpkg apagar os
# arquivos: tira os overrides dos binários setgid, /run/ward (se vazia), as units do
# systemd e os grupos `ward-app`/`ward-nm` que o preinst criou (marca em
# /usr/local/lib/ward/grupos-criados, Fase 51a; como o `make uninstall`). Um grupo que já
# existia antes do Ward fica. Nunca toca no home: o cofre e os backups em
# ~/.local/share/ward/ ficam.
#
# Na instalação abortada (preinst recusou) saem os overrides e os grupos da marca (os
# que esse preinst criou): um grupo que já existia e foi recusado (D60) é do
# administrador, não do Ward.

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
set -euo pipefail

erro() { printf "ward (postrm): %s\n" "$*" >&2; exit 1; }
passo() { printf "ward: %s\n" "$*"; }

#@GRUPOS@

# Marca e pasta do Ward (/usr/local/lib/ward): o dpkg não apaga pasta com arquivo que
# não é do pacote (a marca), então ela sai aqui.
tirar_grupos() {
    apagar_grupos_marcados
    rmdir /usr/local/lib/ward 2>/dev/null || true
}

tirar_overrides() {
    local c
    for c in /usr/local/bin/ward-app /usr/local/lib/ward/ward-nm; do
        if [ -n "$(dpkg-statoverride --list "$c" || true)" ]; then
            dpkg-statoverride --quiet --remove "$c" || true
        fi
    done
}

case "${1:-}" in
    remove | purge)
        tirar_overrides
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl reset-failed 'wardd@*' 2>/dev/null || true
        fi
        if [ -d /run/ward ] && [ ! -L /run/ward ]; then
            for p in /run/ward/*; do
                [ -d "$p" ] && [ ! -L "$p" ] && { rmdir -- "$p" 2>/dev/null || printf 'ward: aviso: %s não está vazia; ficou\n' "$p" >&2; }
            done
            rmdir /run/ward 2>/dev/null || printf 'ward: aviso: /run/ward não está vazia; ficou\n' >&2
        fi
        tirar_grupos
        printf 'ward: o cofre e os backups em ~/.local/share/ward/ não foram tocados\n'
        ;;
    abort-install)
        tirar_overrides
        tirar_grupos
        ;;
    upgrade | failed-upgrade | abort-upgrade | disappear) ;;
    *) printf 'ward (postrm): argumento desconhecido: %s\n' "${1:-}" >&2; exit 1 ;;
esac
exit 0
