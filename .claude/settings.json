{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.local/share/ward/**)",
      "Read(~/.config/ward/**)",
      "Read(/media/**/ward-backup/**)"
    ],
    "allow": [
      "Bash(make dev-daemon:*)",
      "Bash(make dev-daemon-stop:*)",
      "Bash(make test-cli:*)",
      "Bash(make dev-services-up:*)",
      "Bash(make dev-services-down:*)",
      "Bash(make app-bridge:*)",
      "Bash(make test-revealed-selection:*)"
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "figma-to-code-design-to-react-vue-and-html@anthropic-plugin-directory": true
  }
}
