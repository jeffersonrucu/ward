#!/bin/bash -p
# prerm do `.deb` do Ward (Fase 52; D46; V9.9, V9.10). Na remoção, para e desliga todo
# `wardd@<uid>.socket`/`.service` (o cofre trava) antes de o dpkg apagar os arquivos.
# Na atualização não faz nada: o postinst da versão nova reinicia o daemon.

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
set -euo pipefail

case "${1:-}" in
    remove | deconfigure)
        if [ -d /run/systemd/system ]; then
            unidades=()
            while read -r u _; do
                [[ "$u" =~ ^wardd@[0-9]+\.(socket|service)$ ]] && unidades+=("$u")
            done < <(systemctl list-units --all --plain --no-legend --full 'wardd@*' 2>/dev/null || true)
            for p in /etc/systemd/system/*.wants/wardd@*.socket; do
                [ -e "$p" ] || [ -L "$p" ] || continue
                u="${p##*/}"
                [[ "$u" =~ ^wardd@[0-9]+\.socket$ ]] && unidades+=("$u")
            done
            for u in "${unidades[@]}"; do
                if [[ "$u" == *.socket ]]; then
                    systemctl disable --now "$u" || printf 'ward: aviso: não deu para desligar %s\n' "$u" >&2
                else
                    systemctl stop "$u" || printf 'ward: aviso: não deu para parar %s\n' "$u" >&2
                fi
            done
        fi
        ;;
    upgrade | failed-upgrade) ;;
    *) printf 'ward (prerm): argumento desconhecido: %s\n' "${1:-}" >&2; exit 1 ;;
esac
exit 0
